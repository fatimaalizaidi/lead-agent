# Copy to `.env` and fill in your key. Never commit `.env`.
# Used by local uvicorn and by `docker compose` via env_file.

OPENAI_API_KEY=

# Optional tunables (defaults shown) — pydantic Settings + compose environment
# OPENAI_MODEL=gpt-4o-mini
# RAG_K=3
# RAG_SCORE_THRESHOLD=1.2
# OPENAI_TIMEOUT_SECONDS=30

# Compose-only: host port published for the API (container still listens on 8000)
# LEAD_AGENT_PORT=8000
