# Copy to `.env` and fill in your key. Never commit `.env`.
# Used by local uvicorn and by `docker compose` via env_file.

OPENAI_API_KEY=

# Optional tunables (defaults shown) — pydantic Settings + compose environment
# OPENAI_MODEL=gpt-4o-mini
# RAG_K=3
# RAG_SCORE_THRESHOLD=1.2
# Hybrid search + re-ranking (docs/hybrid-rag-reranking.md)
# RAG_HYBRID=true
# RAG_CANDIDATE_K=10
# RAG_RERANKER=auto            # auto | cross-encoder | cohere | none
# COHERE_API_KEY=              # optional; auto uses Cohere when set
# OPENAI_TIMEOUT_SECONDS=30

# Conversation memory (Redis). Compose sets redis://redis:6379/0 by default.
# For local uvicorn against compose Redis published on 6379, use:
# REDIS_URL=redis://localhost:6379/0
# Leave empty to run stateless (memory soft-disabled).
# REDIS_URL=
# MEMORY_TTL_SECONDS=604800
# MEMORY_MAX_MESSAGES=20

# Multi-agent Router (optional). Empty = stub Slack/email notifications.
# SLACK_WEBHOOK_URL=
# EMAIL_WEBHOOK_URL=

# Logging: human key=value lines by default; set true for one JSON object per line.
# LOG_JSON=false
# LOG_LEVEL=INFO

# Compose-only: host port published for the API (container still listens on 8000)
# LEAD_AGENT_PORT=8000

# LangSmith tracing (optional) — see docs/tracing.md. Free key: https://smith.langchain.com → Settings → API Keys
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=lead-agent
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for EU-region accounts
# LANGSMITH_HIDE_INPUTS=true                               # don't send prompts / user messages
# Cost estimates in logs use built-in OpenAI prices; override (USD per 1M tokens) if needed:
# LLM_PRICE_INPUT_PER_1M=0.15
# LLM_PRICE_OUTPUT_PER_1M=0.60
