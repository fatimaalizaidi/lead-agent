# Copy to `.env` and fill in your key. Never commit `.env`.
# Used by local uvicorn and by `docker compose` via env_file.

OPENAI_API_KEY=

# Optional tunables (defaults shown) — pydantic Settings + compose environment
# OPENAI_MODEL=gpt-4o-mini
# RAG_K=3
# RAG_SCORE_THRESHOLD=1.2
# Hybrid search + re-ranking (docs/hybrid-rag-reranking.md)
# RAG_HYBRID=true
# RAG_CANDIDATE_K=10
# RAG_RERANKER=auto            # auto | cross-encoder | cohere | none
# COHERE_API_KEY=              # optional; auto uses Cohere when set
# OPENAI_TIMEOUT_SECONDS=30

# Conversation memory (Redis). Compose sets redis://redis:6379/0 by default.
# For local uvicorn against compose Redis published on 6379, use:
# REDIS_URL=redis://localhost:6379/0
# Leave empty to run stateless (memory soft-disabled).
# REDIS_URL=
# MEMORY_TTL_SECONDS=604800
# MEMORY_MAX_MESSAGES=20

# Multi-agent Router (optional). Empty = stub Slack/email notifications.
# SLACK_WEBHOOK_URL=
# EMAIL_WEBHOOK_URL=

# Logging: human key=value lines by default; set true for one JSON object per line.
# LOG_JSON=false
# LOG_LEVEL=INFO

# Compose-only: host port published for the API (container still listens on 8000)
# LEAD_AGENT_PORT=8000

# LangSmith tracing (optional) — see docs/tracing.md. Free key: https://smith.langchain.com → Settings → API Keys
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=lead-agent
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for EU-region accounts
# LANGSMITH_HIDE_INPUTS=true                               # don't send prompts / user messages
# Cost estimates in logs use built-in OpenAI prices; override (USD per 1M tokens) if needed:
# LLM_PRICE_INPUT_PER_1M=0.15
# LLM_PRICE_OUTPUT_PER_1M=0.60

# API security (docs/security.md). Empty API_KEYS = auth OFF.
# Generate: python -m security new-key n8n   |   python -m security new-secret
# API_KEYS=n8n:la_...,demo:la_...
# JWT_SECRET=
# JWT_TTL_SECONDS=3600
# RATE_LIMIT=20/minute;200/day
# RATE_LIMIT_TOKEN=10/minute
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORAGE_URI=memory://      # redis://... to share limits across instances

# Background jobs (docs/job-queue.md): POST /jobs/* need REDIS_URL, else 503.
# JOB_WORKER_IN_PROCESS=true      # false when a separate `arq jobs.WorkerSettings` runs
# JOB_MAX_CONCURRENCY=2           # OpenAI calls at once per worker
# JOB_MAX_TRIES=3                 # retries for OpenAI 429 / 502, with 5 s, 10 s, 20 s backoff
# JOB_TIMEOUT_SECONDS=120
# JOB_RESULT_TTL_SECONDS=3600     # how long GET /jobs/{id} keeps a finished result
# RATE_LIMIT_POLL=120/minute

# Fine-tuned priority classifier (docs/fine-tuning.md): POST /classify-priority, no OpenAI.
# PRIORITY_MODEL_DIR=finetune/model   # int8 ONNX + tokenizer; missing → 503 classifier_unavailable
# CLASSIFIER_ROUTE_ENABLED=true       # /analyze-lead: confident Low skips RAG + OpenAI (routing.py)
# CLASSIFIER_ROUTE_THRESHOLD=0.7      # 0 wrong routes on the hand-written test set at 0.7

# Public demo page at /demo (docs/demo.md)
# DEMO_ENABLED=true
# DEMO_DAILY_LLM_LIMIT=200            # OpenAI analyses per UTC day across all visitors
# DEMO_RATE_LIMIT=6/minute;40/day     # per IP
# DEMO_CLASSIFY_RATE_LIMIT=30/minute  # per IP, classifier only
